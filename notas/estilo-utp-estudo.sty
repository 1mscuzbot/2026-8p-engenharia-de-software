\sloppy
\tolerance=9999999
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0.0cm}

% Hierarquia visual das seções (igual ao TCC UTP).
\renewcommand{\ABNTEXchapterfont}{\bfseries}
\renewcommand{\ABNTEXchapterfontsize}{\normalsize}
\renewcommand{\ABNTEXsectionfont}{\normalfont}
\renewcommand{\ABNTEXsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsectionfont}{\normalfont}
\renewcommand{\ABNTEXsubsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsubsectionfont}{\normalfont}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize}

\setlength\afterchapskip{.6cm}
\setlength\aftersecskip{.4cm}
\setlength\aftersubsecskip{.4cm}
\setlength\aftersubsubsecskip{.4cm}

% Página: número no cabeçalho (estilo UTP).
\makepagestyle{estiloutp}
\makeevenhead{estiloutp}{}{}{\scriptsize{\thepage}}
\makeoddhead{estiloutp}{}{}{\scriptsize{\thepage}}
\makeevenfoot{estiloutp}{}{}{}
\makeoddfoot{estiloutp}{}{}{}

\makepagestyle{abntchapfirst}
\makeoddhead{abntchapfirst}{}{}{\scriptsize\thepage}

\renewcommand{\textual}{%
    \pagestyle{estiloutp}%
    \aliaspagestyle{chapter}{abntchapfirst}%
    \nouppercaseheads%
    \bookmarksetup{startatroot}%
}

\addto\captionsbrazil{%
    \renewcommand{\bibname}{REFERÊNCIAS}
}

% Capa simples para estudo dirigido (disciplina + aluno + título).
\renewcommand{\imprimircapa}{%
    \begin{capa}%
        \centering
        {\bfseries\large\MakeUppercase{\imprimirinstituicao}\par}
        \vspace*{2.2cm}

        {\bfseries\large\MakeUppercase{\imprimirautor}\par}
        \vfill

        {\bfseries\large\MakeUppercase{\imprimirtitulo}\par}
        \vfill

        {\bfseries\large\MakeUppercase{\imprimirlocal}\par}
        \vspace*{0.2cm}
        {\bfseries\large\MakeUppercase{\imprimirdata}\par}

    \end{capa}
}

